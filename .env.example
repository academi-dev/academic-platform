# ==============================================================================
# Academic Platform — Plantilla de Variables de Entorno (.env.example)
# Organización: academic-dev
# Equipo:
#   - Jean Mena (@hilton45)
#   - Eyfer Mena (@Eyfer3174)
# ==============================================================================
# INSTRUCCIONES:
# Copia este archivo como '.env' en la raíz de 'academic-platform':
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Ajusta los valores sensibles antes de iniciar los servicios en producción.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración de Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# Nombre de la base de datos principal
POSTGRES_DB=academic_db

# Usuario administrador de la base de datos
POSTGRES_USER=academic_user

# Contraseña del usuario de la base de datos (¡CAMBIAR EN PRODUCCIÓN!)
POSTGRES_PASSWORD=change-me-in-production

# Puerto expuesto en el host para PostgreSQL
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Seguridad y Autenticación JWT (academic-api)
# ------------------------------------------------------------------------------
# Clave secreta para la firma de tokens JWT (¡GENERAR UNA CLAVE SEGURA EN PRODUCCIÓN!)
# Ejemplo de generación: openssl rand -hex 32
SECRET_KEY=change-me-in-production

# Algoritmo de cifrado para tokens JWT
ALGORITHM=HS256

# Tiempo de expiración del token de acceso (en minutos, expiración corta por seguridad)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# 3. Bot de Telegram (academic-bot)
# ------------------------------------------------------------------------------
# Token de acceso proporcionado por @BotFather en Telegram
# Obtenerlo en: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-bot-token

# ------------------------------------------------------------------------------
# 4. Inteligencia Artificial y RAG (academic-rag)
# ------------------------------------------------------------------------------
# Clave API de OpenAI (solo si LLM_PROVIDER=openai)
# Dejar vacío para usar el modo local (sin costo)
OPENAI_API_KEY=

# Proveedor de respuestas: 'local' (extractivo, gratis) u 'openai'
LLM_PROVIDER=local

# Modelo de embeddings de sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 5. Puertos de Servicios en el Host
# ------------------------------------------------------------------------------
# Puerto expuesto para la API principal (academic-api)
API_PORT=8000

# Puerto expuesto para el servicio RAG (academic-rag)
RAG_PORT=8001

# Puerto expuesto para el Gateway Nginx (Reverse Proxy unificado)
GATEWAY_PORT=80

# ------------------------------------------------------------------------------
# 6. Entorno y Logging
# ------------------------------------------------------------------------------
# Entorno de ejecución: 'development', 'staging', 'production'
ENVIRONMENT=development

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
